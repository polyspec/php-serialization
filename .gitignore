node_modules/
target/
vendor/
__pycache__/
.DS_Store
.cache/
/var/
# The sources that make bindings writes from the interface contract (binding design L-1); they are not tracked.
/packages/*/generated/
# The generated folders of the WASM crate and of the C ABI crate of Go, and the Go files zz_generated_*.go of
# packages/go, which a release adds in the commit of its Go tag (binding GN-15g).
/packages/ts/wasm/generated/
/packages/go/internal/ffi/generated/
/packages/go/**/zz_generated_*.go
# The release recipes that make release-recipes writes with binding (binding GN-19h), and the folder of the npm platform
# packages that make release-npm-platform writes inside the npm package, since the napi CLI refuses a folder outside it.
/packages/release.mk
/packages/ts/npm/
.venv/
*.egg-info/

# Generated files of the install, build, cache and test runs (AGENTS.md, Generated files)
dist/
build/
dist.next/
dist.old/
*.tsbuildinfo
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.phpunit.cache/
.phpunit.result.cache
test-results/
playwright-report/
coverage/

# The go.work files that link writes into a consumer (kit local-links.md); they are never committed.
go.work
go.work.sum

# The link declaration of kit (K869), which the local links read from the main checkout.
/.links
