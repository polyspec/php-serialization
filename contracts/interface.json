  "changes": [
    {
      "id": "change-errors-node",
      "rule": "RQ-010",
      "reason": "RQ-010: every failure has a kind; P-5: a class without a kind does not tell a refusal on purpose from a corrupt record",
      "symbol": "UnserializeError, serialize",
      "from": {
        "node": "class UnserializeError extends Error { readonly offset: number }; serialize throws TypeError or RangeError"
      },
      "to": "format_error"
    },
    {
      "id": "change-errors-python",
      "rule": "RQ-010",
      "reason": "RQ-010, as change-errors-node",
      "symbol": "UnserializeError, serialize",
      "from": {
        "python": "class UnserializeError(ValueError) with offset; serialize raises TypeError, OverflowError or ValueError"
      },
      "to": "format_error"
    },
    {
      "id": "change-top-reference",
      "rule": "RQ-008",
      "reason": "RQ-008: PHP has no top reference; writing its value turns a value that PHP cannot hold into another (P-3)",
      "symbol": "serialize",
      "from": {
        "node": "serialize(new Reference(v)) writes v",
        "python": "serialize(Reference(v)) writes v"
      },
      "to": "serialize"
    },
    {
      "id": "change-php-package",
      "rule": "RQ-011",
      "reason": "RQ-011: the PHP extension is a new package of the crate; PHP's own serialize stays the oracle",
      "symbol": "Polyspec\\PhpSerialize",
      "from": {
        "php": "none"
      },
      "to": "functions"
    }
