{
  "name": "@polyspec/php-serialization",
  "version": "0.0.6",
  "description": "The php-serialization library of polyspec for Node",
  "license": "MIT",
  "main": "./generated/index.cjs",
  "types": "./generated/index.d.ts",
  "exports": {
    ".": {
      "types": "./generated/index.d.ts",
      "import": "./generated/index.mjs",
      "require": "./generated/index.cjs"
    }
  },
  "files": [
    "generated/index.cjs",
    "generated/index.mjs",
    "generated/index.d.ts"
  ],
  "optionalDependencies": {
    "@polyspec/php-serialization-linux-x64-gnu": "0.0.6",
    "@polyspec/php-serialization-linux-arm64-gnu": "0.0.6",
    "@polyspec/php-serialization-darwin-arm64": "0.0.6"
  }
}
