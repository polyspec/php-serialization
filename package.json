{
  "name": "@polyspec/php-serialization-workspace",
  "version": "0.0.6",
  "private": true,
  "description": "The workspace of the PHP serialize format for Node.js and Python",
  "type": "module",
  "exports": {
    ".": {
      "types": "./legacy/packages/js/index.d.ts",
      "import": "./legacy/packages/js/index.js"
    }
  },
  "files": [
    "legacy/packages/js"
  ],
  "engines": {
    "node": ">=26.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/polyspec/php-serialization.git"
  },
  "devDependencies": {
    "@polyspec/kit": "https://github.com/polyspec/kit/releases/download/v0.0.105/polyspec-kit-0.0.105.tgz",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
