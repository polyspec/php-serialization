{
  "schema": 1,
  "repositoryUrl": "https://github.com/polyspec/php-serialize",
  "changelog": "CHANGELOG.md",
  "changelogTranslations": [
    "CHANGELOG.ko.md"
  ],
  "packages": [
    {
      "kind": "npm",
      "directory": "packages/js",
      "name": "@polyspec/php-serialize",
      "product": "php-serialize",
      "runtime": "ts"
    },
    {
      "kind": "wheel",
      "directory": "packages/python",
      "name": "polyspec-php-serialize",
      "product": "php-serialize",
      "runtime": "python"
    }
  ],
  "manifests": {
    "package.json": "version",
    "packages/js/package.json": "archive",
    "packages/python/pyproject.toml": "archive"
  },
  "notReleased": {
    "packages/rust/Cargo.toml": "the core crate polyspec-php-serialize, publish = false: the bindings that contracts/interface.json generates build it from the source of the checkout (RQ-011), and no runtime installs it alone"
  },
  "goModules": {},
  "annotatedTags": true,
  "packageFiles": [
    "package.json",
    "composer.json",
    "Cargo.toml",
    "pyproject.toml",
    "go.mod",
    "VERSION"
  ],
  "writtenFiles": [
    "config/phpunit/composer.json",
    ".mise/locks/**"
  ]
}
