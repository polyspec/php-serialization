{
  "schema": 1,
  "comment": "The checks that own each tracked path, read by owner-check of @polyspec/kit.",
  "owners": [
    {
      "paths": [
        "**/*.md",
        "config/documents.json"
      ],
      "targets": [
        "docs-check"
      ]
    },
    {
      "paths": [
        "docs/plans/execution/checklist.md",
        "docs/plans/execution/checklist.ko.md"
      ],
      "targets": [
        "docs-check"
      ]
    },
    {
      "paths": [
        "scripts/*.mts",
        ".gitignore",
        "Makefile",
        "tsconfig.json"
      ],
      "targets": [
        "typecheck"
      ]
    },
    {
      "paths": [
        "scripts/contracts.mts",
        "scripts/php-tree.mts",
        "contracts/php-serialize.json",
        ".php-version"
      ],
      "targets": [
        "contracts-check"
      ]
    },
    {
      "paths": [
        "scripts/fuzz.mts",
        "scripts/fuzz-temp.mts",
        "scripts/fuzz-temp.test.mts",
        "packages/js/index.js",
        "packages/js/tests/*",
        "packages/python/src/polyspec/php_serialize/*",
        "packages/python/tests/*",
        "packages/rust/src/**",
        "packages/rust/examples/**",
        "packages/rust/tests/common/**"
      ],
      "targets": [
        "fuzz"
      ]
    },
    {
      "paths": [
        "package.json",
        "packages/js/package.json",
        "packages/python/pyproject.toml",
        "config/release.json",
        "CHANGELOG.md",
        "CHANGELOG.ko.md"
      ],
      "targets": [
        "release-coverage"
      ]
    },
    {
      "paths": [
        "Makefile",
        ".github/workflows/*.yml",
        ".github/actions/**"
      ],
      "targets": [
        "rules-check",
        "owner-validate"
      ]
    },
    {
      "paths": [
        "config/checklist.json",
        "config/owner-checks.json"
      ],
      "targets": [
        "owner-validate",
        "docs-check"
      ]
    },
    {
      "paths": [
        ".editorconfig",
        ".npmrc",
        "package-lock.json",
        "config/*.json",
        "config/*.yml",
        "LICENSE",
        "packages/js/LICENSE",
        "packages/python/LICENSE",
        "mise.toml",
        "mise.lock",
        ".mise/**"
      ],
      "targets": []
    },
    {
      "paths": [
        "packages/**",
        "docs/spec/*.md"
      ],
      "targets": [
        "test-js",
        "test-python"
      ]
    },
    {
      "paths": [
        "config/layout.yml",
        "config/layout.kit.yml",
        "config/composer.schema.json"
      ],
      "targets": [
        "layout-check"
      ]
    },
    {
      "paths": [
        "config/rebuild.json"
      ],
      "targets": [
        "rebuild-check"
      ]
    },
    {
      "paths": [
        "config/duplication.json"
      ],
      "targets": [
        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.mts",
        "**/*.mjs",
        "**/*.js",
        "**/*.ts",
        ".oxlintrc.json",
        "knip.json"
      ],
      "targets": [
        "lint-ts",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.py",
        "ruff.toml"
      ],
      "targets": [
        "lint-python",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "packages/rust/**",
        "clippy.toml",
        "rust-toolchain.toml"
      ],
      "targets": [
        "lint-rust",
        "test-rust"
      ]
    },
    {
      "paths": [
        "contracts/interface.json"
      ],
      "targets": []
    }
  ]
}
