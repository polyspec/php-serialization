{
  "schema": 1,
  "comment": "The checks that own each tracked path, read by owner-check of @polyspec/kit.",
  "owners": [
    {
      "paths": [
        "**/*.md",
        "config/documents.json"
      ],
      "targets": [
        "docs-check"
      ]
    },
    {
      "paths": [
        "docs/plans/execution/checklist.md",
        "docs/plans/execution/checklist.ko.md"
      ],
      "targets": [
        "docs-check"
      ]
    },
    {
      "paths": [
        "scripts/*.mts",
        ".gitignore",
        "Makefile",
        "tsconfig.json"
      ],
      "targets": [
        "typecheck"
      ]
    },
    {
      "paths": [
        "scripts/contracts.mts",
        "scripts/php-tree.mts",
        "contracts/php-serialize.json",
        ".php-version"
      ],
      "targets": [
        "contracts-check"
      ]
    },
    {
      "paths": [
        "scripts/fuzz.mts",
        "scripts/fuzz-temp.mts",
        "scripts/fuzz-temp.test.mts",
        "legacy/packages/js/index.js",
        "legacy/packages/js/tests/*",
        "legacy/packages/python/src/polyspec/php_serialize/*",
        "legacy/packages/python/tests/*",
        "packages/rust/src/**",
        "packages/rust/examples/**",
        "packages/rust/tests/common/**"
      ],
      "targets": [
        "fuzz"
      ]
    },
    {
      "paths": [
        "package.json",
        "legacy/packages/js/package.json",
        "legacy/packages/python/pyproject.toml",
        "config/release.json",
        "CHANGELOG.md",
        "CHANGELOG.ko.md",
        "Cargo.toml",
        "packages/python/pyproject.toml",
        "packages/ts/package.json",
        "packages/php-ext/composer.json"
      ],
      "targets": [
        "release-coverage"
      ]
    },
    {
      "paths": [
        "Makefile",
        ".github/workflows/*.yml",
        ".github/actions/**",
        "scripts/workflows.test.mts"
      ],
      "targets": [
        "rules-check",
        "owner-validate"
      ]
    },
    {
      "paths": [
        "config/checklist.json",
        "config/owner-checks.json"
      ],
      "targets": [
        "owner-validate",
        "docs-check"
      ]
    },
    {
      "paths": [
        ".editorconfig",
        ".npmrc",
        "package-lock.json",
        "config/*.json",
        "config/*.yml",
        "LICENSE",
        "legacy/packages/js/LICENSE",
        "legacy/packages/python/LICENSE",
        "mise.toml",
        "mise.lock",
        ".mise/**"
      ],
      "targets": []
    },
    {
      "paths": [
        "legacy/packages/**",
        "docs/spec/*.md"
      ],
      "targets": [
        "test-js",
        "test-python"
      ]
    },
    {
      "paths": [
        "config/layout.yml",
        "config/layout.kit.yml",
        "config/composer.schema.json",
        "config/cargo.schema.json"
      ],
      "targets": [
        "layout-check"
      ]
    },
    {
      "paths": [
        "config/rebuild.json"
      ],
      "targets": [
        "rebuild-check"
      ]
    },
    {
      "paths": [
        "config/duplication.json"
      ],
      "targets": [
        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.mts",
        "**/*.mjs",
        "**/*.js",
        "**/*.ts",
        ".oxlintrc.json",
        "knip.json"
      ],
      "targets": [
        "lint-ts",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.py",
        "ruff.toml"
      ],
      "targets": [
        "lint-python",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "packages/rust/**",
        "clippy.toml",
        "rust-toolchain.toml",
        "Cargo.toml",
        "Cargo.lock",
        "contracts/host-values.json"
      ],
      "targets": [
        "lint-rust",
        "test-rust"
      ]
    },
    {
      "paths": [
        "packages/python/**",
        "packages/ts/**",
        "packages/php-ext/**",
        "packages/go/**",
        "packages/rust/interface.json",
        "Cargo.lock"
      ],
      "targets": [
        "bindings-check"
      ]
    },
    {
      "paths": [
        "Makefile",
        "rust-toolchain.toml",
        "config/toolchain.json"
      ],
      "targets": [
        "bindings-check"
      ]
    },
    {
      "paths": [
        "scripts/binding-features.test.mts",
        "Makefile",
        "packages/python/Cargo.toml",
        "packages/ts/Cargo.toml",
        "packages/ts/wasm/Cargo.toml",
        "packages/php-ext/Cargo.toml",
        "packages/go/internal/ffi/Cargo.toml"
      ],
      "targets": [
        "binding-features-test"
      ]
    },
    {
      "paths": [
        "**/*.md",
        "scripts/check-commit-names.mts",
        "scripts/commit-names.test.mts"
      ],
      "targets": [
        "commit-names-check",
        "commit-names-test"
      ]
    }
  ]
}
